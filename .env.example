# -----------------------------------------------------------------------------
# Bu dosyayı `.env.local` olarak kopyala ve değerleri doldur.
#   cp .env.example .env.local
# `.env.local` git'e gitmez (.gitignore'da).
# -----------------------------------------------------------------------------

# Asistan için Claude API anahtarı.
# Al: https://console.anthropic.com/settings/keys
# Boş bırakırsan site çalışır, sadece sohbet penceresi "yapılandırılmamış" der.
ANTHROPIC_API_KEY=

# Kullanılacak model. Varsayılan: claude-opus-5 (en yetenekli).
# Maliyeti düşürmek istersen: claude-sonnet-5 ya da claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5
