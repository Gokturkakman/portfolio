# -----------------------------------------------------------------------------
# Bu dosyayı `.env.local` olarak kopyala ve değerleri doldur.
#   cp .env.example .env.local
# `.env.local` git'e gitmez (.gitignore'da).
# -----------------------------------------------------------------------------

# Asistan için Gemini API anahtarı. Ücretsiz: kredi kartı ya da bakiye
# gerekmiyor, sadece dakika/gün başına bir istek sınırı var.
# Al: https://aistudio.google.com/apikey
# Boş bırakırsan site çalışır, sadece sohbet penceresi "yapılandırılmamış" der.
GEMINI_API_KEY=

# Kullanılacak model. Varsayılan: gemini-3.6-flash (hızlı, ücretsiz katmana uygun).
GEMINI_MODEL=gemini-3.6-flash
